{
  "plugins": ["react", "import"],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/campaign/**",
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/admin/**",
              "ui_kits/campaign/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cy Grotesk|Gotham|Inter|Neue Haas|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Cy Grotesk, Gotham, Inter, Neue Haas, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|footer|children|key|ref|className|style|children)$/]",
        "message": "<AdminCard> doesn't accept that prop. Declared props: title, meta, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<AdminNavItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|services|quote|attribution|note|key|ref|className|style|children)$/]",
        "message": "<AreaHero> doesn't accept that prop. Declared props: title, services, quote, attribution, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='Area'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|note|href|key|ref|className|style|children)$/]",
        "message": "<Area> doesn't accept that prop. Declared props: id, label, note, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|accent|disabled|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, shape, accent, disabled, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|ghost|invert)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'ghost' | 'invert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Button> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampaignCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|label|note|textureSrc|artSrc|onClick|key|ref|className|style|children)$/]",
        "message": "<CampaignCTA> doesn't accept that prop. Declared props: title, body, label, note, textureSrc, artSrc, onClick."
