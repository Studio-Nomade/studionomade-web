# Entorno lógico de la aplicación: local | preview | production
NEXT_PUBLIC_APP_ENV=local

# URL pública de este despliegue. No incluir tokens ni credenciales.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase. La clave publishable es pública por diseño: toda lectura y escritura
# que haga queda sujeta a RLS. NUNCA pongas aquí la service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Allowlist de acceso al panel, separada por comas.
# Formato: persona@studionomade.cl para un correo, @studionomade.cl para todo un dominio.
# DENY BY DEFAULT: si queda vacía, nadie puede entrar.
AUTH_ALLOWLIST=

# Credenciales de Google OAuth. Las consume Supabase Auth (supabase/config.toml en
# local; el dashboard del proyecto en la nube). No se versionan.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
