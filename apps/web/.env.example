# Entorno lógico de la aplicación: local | preview | production
NEXT_PUBLIC_APP_ENV=local

# URL pública de este despliegue. No incluir tokens ni credenciales.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Captura server-side de leads. Mantener vacíos en Git; cargar valores por entorno.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_IP_SALT=
LEAD_FORM_SECRET=
SLACK_LEADS_WEBHOOK_URL=
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=
LEADS_NOTIFY_TO=

# Medición de campañas (docs/analytics-campanas.md). Públicas por diseño: se
# incrustan en el bundle del navegador. Vacío = no se carga el píxel ni se abre
# el CSP a Meta.
NEXT_PUBLIC_META_PIXEL_ID=
# implicit (por defecto): mide salvo Do Not Track / Global Privacy Control.
# explicit: no mide hasta que un banner llame a setAnalyticsConsent("granted").
NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=implicit

# Instagram (@studionomade_): token de larga duración de la API de Instagram con
# inicio de sesión de Instagram. Solo servidor. Sin él, la home muestra una
# selección fija. Dura 60 días: ver docs/analytics-campanas.md → Instagram.
INSTAGRAM_ACCESS_TOKEN=
